     *  变量插值 pattern 规则（处理「插件「X」已安装」这类拼接文本）
     *  格式：[/正则/, '替换模板（可用 $1 $2）']
     * ====================================================== */
    var PATTERNS = [
        [/^插件「(.+)」已安装，但运行失败$/, 'Plugin "$1" installed, but failed to run'],
        [/^插件「(.+)」已安装$/, 'Plugin "$1" installed'],
        [/^已安装「(.+)」$/, 'Installed "$1"'],
        // 以下 pattern 允许任意 emoji/符号前缀（$1 保留前缀），并处理中文冒号
        [/^([^\u4e00-\u9fff]*)插件安装失败：(.+)$/, '$1Plugin install failed: $2'],
        [/^([^\u4e00-\u9fff]*)安装失败：(.+)$/, '$1Install failed: $2'],
        [/^([^\u4e00-\u9fff]*)导出失败：(.+)$/, '$1Export failed: $2'],
        [/^([^\u4e00-\u9fff]*)导入失败：(.+)$/, '$1Import failed: $2'],
        [/^([^\u4e00-\u9fff]*)导入贴纸失败:(.+)$/, '$1Sticker import failed: $2'],
        [/^([^\u4e00-\u9fff]*)拉取失败：(.+)$/, '$1Fetch failed: $2'],
        [/^([^\u4e00-\u9fff]*)保存失败：(.+)$/, '$1Save failed: $2'],
        [/^([^\u4e00-\u9fff]*)已复制：(.+)$/, '$1Copied: $2'],
        [/^([^\u4e00-\u9fff]*)已下载：(.+)$/, '$1Downloaded: $2'],
        [/^插件「(.+)」请求访问互联网（HTTP 请求）。\n仅在你信任此插件时允许。$/, 'Plugin "$1" is requesting internet access (HTTP requests).\nOnly allow if you trust this plugin.'],
        [/^确定要删除账号「(.+)」吗？\n\n• 该账号的聊天记录、好友、表情包、文件等将被永久删除\n• 操作不可撤销\n\n请确认继续。$/, 'Delete account "$1"?\n\n• Chat history, friends, stickers and files of this account will be permanently deleted\n• This action cannot be undone\n\nPlease confirm.'],
        [/^最多只能创建 (\d+) 个账号，请先删除不需要的账号。$/, 'You can create up to $1 accounts. Delete unneeded ones first.'],
        [/^最多只能创建 (\d+) 个账号$/, 'You can create up to $1 accounts'],
        [/^确定删除选中的 (\d+) 项吗？此操作不可撤销。$/, 'Delete $1 selected item(s)? This action cannot be undone.'],
        [/^([^\u4e00-\u9fff]*)账号已删除，已切换到 (.+)$/, '$1Account deleted. Switched to "$2"'],
        [/^已切换到 (.+)$/, 'Switched to "$1"'],
        [/^([^\u4e00-\u9fff]*)下载失败（(.+)）$/, '$1Download failed ($2)'],
        [/^当前地址 “#(.+)” 不属于 SuChat 的页面。$/, 'The address "#$1" is not a SuChat page.']
    ];

    /* ========================================================
     *  翻译核心
     *  1) 整句精确匹配  2) 变量插值 pattern  3) 首尾中文拆分（保留 emoji/符号前后缀）
     * ====================================================== */
    function coreSplit(s) {
        var first = s.search(CN_RE);
        if (first < 0) return null;
        var last = -1;
        for (var i = s.length - 1; i >= 0; i--) {
            if (CN_RE.test(s.charAt(i))) { last = i; break; }
        }
        return {
            prefix: s.slice(0, first),
            core: s.slice(first, last + 1),
            suffix: s.slice(last + 1)
        };
    }

    function applyPatterns(s) {
        for (var i = 0; i < PATTERNS.length; i++) {
            if (PATTERNS[i][0].test(s)) return s.replace(PATTERNS[i][0], PATTERNS[i][1]);
        }
        return null;
    }

    function translateText(s) {
        if (!s || !CN_RE.test(s)) return s;
        // 1. 整句精确匹配
        if (DICT[s]) return DICT[s];
        // 2. 变量插值 pattern（整句）
        var p = applyPatterns(s);
        if (p !== null) return p;
        // 3. 拆分前后缀再匹配（处理 '✅ 亮色' / '—— 主题 ——' 等）
        var c = coreSplit(s);
        if (c) {
            if (DICT[c.core]) return c.prefix + DICT[c.core] + c.suffix;
            var p2 = applyPatterns(c.core);
            if (p2 !== null) return c.prefix + p2 + c.suffix;
        }
        return s;
    }

    // 用于 DOM 文本节点：保留首尾空白
    function translateNodeText(s) {
        if (!s || !CN_RE.test(s)) return s;
        var m = s.match(/^(\s*)([\s\S]*?)(\s*)$/);
        var t = translateText(m[2]);
        if (t === m[2]) return s;
        return m[1] + t + m[3];
    }

    /* ========================================================
     *  DOM 扫描翻译（文本节点 + placeholder + title）
     * ====================================================== */
    var _origNodes = new Map();   // textNode -> original text（卸载恢复用）
    var _origAttrs = new Map();   // element -> { placeholder: v, title: v }

    function scanDom(root) {
        root = root || document.body;
        if (!root) return;

        // --- 文本节点 ---
        try {
            var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
                acceptNode: function (node) {
                    var t = node.textContent;
                    if (!t || !CN_RE.test(t)) return NodeFilter.FILTER_REJECT; // 无中文直接跳过，开销极低
                    if (_origNodes.has(node)) return NodeFilter.FILTER_REJECT;
                    var p = node.parentElement;
                    if (!p) return NodeFilter.FILTER_REJECT;
                    var tag = p.tagName;
                    if (tag === 'SCRIPT' || tag === 'STYLE' || tag === 'TEXTAREA' ||
                        tag === 'INPUT' || tag === 'NOSCRIPT') return NodeFilter.FILTER_REJECT;
                    if (p.isContentEditable) return NodeFilter.FILTER_REJECT;
                    // 跳过聊天正文（气泡文本 / 引用文本 / 引用预览），避免误翻用户消息
                    if (p.closest && p.closest('.m-text, .mq-text, .qp-text')) return NodeFilter.FILTER_REJECT;
                    return NodeFilter.FILTER_ACCEPT;
                }
            });
            var n;
            while ((n = walker.nextNode())) {
                var orig = n.textContent;
                var t = translateNodeText(orig);
                if (t !== orig) {
                    _origNodes.set(n, orig);
                    n.textContent = t;
                }
            }
        } catch (e) {}

        // --- placeholder / title 属性 ---
        try {
            var els = root.querySelectorAll ? root.querySelectorAll('[placeholder],[title]') : [];
            for (var i = 0; i < els.length; i++) {
                var el = els[i];
                var ph = el.getAttribute && el.getAttribute('placeholder');
                if (ph && CN_RE.test(ph)) {
                    el.setAttribute('placeholder', translateText(ph));
                    var r1 = _origAttrs.get(el) || {};
                    if (!r1.placeholder) { r1.placeholder = ph; _origAttrs.set(el, r1); }
                }
                var ti = el.getAttribute && el.getAttribute('title');
                if (ti && CN_RE.test(ti)) {
                    el.setAttribute('title', translateText(ti));
                    var r2 = _origAttrs.get(el) || {};
                    if (!r2.title) { r2.title = ti; _origAttrs.set(el, r2); }
                }
            }
        } catch (e) {}

        // --- document.title 兜底 ---
        try {
            if (CN_RE.test(document.title)) document.title = translateText(document.title);
        } catch (e) {}
    }

    function restoreDom() {
        _origNodes.forEach(function (original, node) {
            try { if (node && node.parentNode) node.textContent = original; } catch (e) {}
        });
        _origNodes.clear();
        _origAttrs.forEach(function (rec, el) {
            try {
                if (!el || !el.parentNode) return;
                if (rec.placeholder) el.setAttribute('placeholder', rec.placeholder);
                if (rec.title) el.setAttribute('title', rec.title);
            } catch (e) {}
        });
        _origAttrs.clear();
    }

    /* ========================================================
     *  1. 注册动态文本过滤器（toast / 会话列表 / 请求列表等宿主 _tf 出口）
     * ====================================================== */
    api.ui.registerTextFilter(function (text) {
        return translateText(text);
    });

    /* ========================================================
     *  2. 初始扫描 + MutationObserver 监听（150ms 防抖）
     * ====================================================== */
    var _observer = null;
    var _debounceTimer = null;
    var _intervalTimer = null;

    function scheduleScan() {
        if (_debounceTimer) clearTimeout(_debounceTimer);
        _debounceTimer = setTimeout(function () { scanDom(); }, 150);
    }

    function startObserver() {
        if (_observer || !document.body) return;
        _observer = new MutationObserver(function (mutations) {
            for (var i = 0; i < mutations.length; i++) {
                var m = mutations[i];
                if ((m.type === 'childList' && m.addedNodes.length > 0) ||
                    (m.type === 'attributes' && (m.attributeName === 'placeholder' || m.attributeName === 'title'))) {
                    scheduleScan();
                    return;
                }
            }
        });
        _observer.observe(document.body, {
            childList: true,
            subtree: true,
            attributes: true,
            attributeFilter: ['placeholder', 'title']
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () {
            scanDom();
            startObserver();
        });
    } else {
        scanDom();
        startObserver();
    }

    /* ========================================================
     *  3. 低频兜底轮询（4s）：惰性清理失效引用 + 补扫漏网文本
     * ====================================================== */
    _intervalTimer = setInterval(function () {
        // 惰性清理已脱离 DOM 的节点引用，防止内存累积
        if (_origNodes.size > 0) {
            var dead = [];
            _origNodes.forEach(function (_, node) {
                if (!node || !node.isConnected) dead.push(node);
            });
            for (var i = 0; i < dead.length; i++) _origNodes.delete(dead[i]);
        }
        if (_origAttrs.size > 0) {
            var deadEls = [];
            _origAttrs.forEach(function (_, el) {
                if (!el || !el.isConnected) deadEls.push(el);
            });
            for (var j = 0; j < deadEls.length; j++) _origAttrs.delete(deadEls[j]);
        }
        scanDom();
    }, 4000);

    /* ========================================================
     *  4. 卸载清理（完整恢复中文）
     * ====================================================== */
    api.onUnload(function () {
        if (_observer) { try { _observer.disconnect(); } catch (e) {} _observer = null; }
        if (_debounceTimer) { clearTimeout(_debounceTimer); _debounceTimer = null; }
        if (_intervalTimer) { clearInterval(_intervalTimer); _intervalTimer = null; }
        restoreDom();
        api.toast('已恢复中文界面');
    });

    api.toast('🇬🇧 English patch loaded');

})(typeof SuChatPlugin !== 'undefined' && SuChatPlugin ? SuChatPlugin : (typeof window !== 'undefined' && window.SuChatPlugin));

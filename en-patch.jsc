/**
 * SuChat 插件：英文补丁
 *
 * @id          suchat-en-patch
 * @name        英文补丁
 * @version     2.0.0
 * @author      SuChat Team
 * @desc        将应用界面翻译为英文。覆盖账号管理、聊天背景、消息引用、插件安装器.    Translate the app interface into English. Cover account management, chat backgrounds, message quoting, plugin installer.
 *              文件管理等全部界面；支持含变量拼接的提示语（如「插件「X」已安装」）；
 *              翻译 placeholder 与 title 属性；自动跳过聊天正文防止误翻用户消息；
 *              卸载后完整恢复中文。
 *
 * @permissions ui_text_filter
 */
(function (SuChatPlugin) {
    'use strict';

    var api = SuChatPlugin || (typeof window !== 'undefined' && window.SuChatPlugin);
    if (!api) return;

    var CN_RE = /[\u4e00-\u9fff]/;


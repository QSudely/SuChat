/**
 * SuChat 插件：多彩主题
 *
 * 提供 6 套色彩主题（赤红、蔚蓝、林绿、谜紫、橙黄、幻粉），
 * 每套均含暗色 / 亮色双模配色，自动跟随宿主明暗主题切换。
 * 在个人主页「主题」区域下方「色彩」行选择即可。
 *
 * @id          suchat-plugin-color-themes
 * @name        多彩主题
 * @version     1.1.0
 * @author      SuChat
 * @desc        6 套色彩主题（赤红/蔚蓝/林绿/谜紫/橙黄/幻粉），自动适配明暗色主题
 * @permissions storage
 */
(function (SuChatPlugin) {
    'use strict';

    var STYLE_ID = '__suchat_color_themes__';
    var PICKER_ID = '__suchat_color_picker__';
    var PICKER_STYLE_ID = '__suchat_color_picker_style__';
    var STORAGE_KEY = 'active_color';

    /* ========================================================
     *  通用变量（各色彩主题共用，不随色彩变化）
     * ====================================================== */
    var COMMON_DARK = {
        'danger': '#e74c5e', 'success': '#4cd9a0', 'warning': '#f39c12',
        'danger-2': '#f28b82',
        'danger-soft-bg': 'rgba(231,76,94,0.15)',
        'danger-soft-border': 'rgba(231,76,94,0.3)',
        'online': '#4cd9a0'
    };
    var COMMON_LIGHT = {
        'danger': '#dc3545', 'success': '#15a877', 'warning': '#e27900',
        'danger-2': '#c9382f',
        'danger-soft-bg': 'rgba(220,53,69,0.12)',
        'danger-soft-border': 'rgba(220,53,69,0.25)',
        'online': '#15a877'
    };


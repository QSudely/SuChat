    /* ========================================================
     *  工具函数
     * ====================================================== */
    function merge(a, b) {
        var r = {};
        for (var k in a) r[k] = a[k];
        for (var k in b) r[k] = b[k];
        return r;
    }

    function showToast(msg) {
        try { SuChatPlugin.toast(msg); return; } catch (e) {}
        var t = document.createElement('div');
        t.textContent = msg;
        t.style.cssText = 'position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,0.75);color:#fff;padding:12px 24px;border-radius:10px;font-size:14px;z-index:99999;pointer-events:none;transition:opacity .3s';
        document.body.appendChild(t);
        setTimeout(function () { t.style.opacity = '0'; }, 2000);
        setTimeout(function () { t.remove(); }, 2400);
    }

    /* ========================================================
     *  CSS 生成
     * ====================================================== */

    /* 生成变量覆盖（暗色 :root + 亮色 :root.light-theme） */
    function buildVars(p) {
        var dv = merge(COMMON_DARK, p.dark.v);
        var lv = merge(COMMON_LIGHT, p.light.v);
        var lines = [];
        lines.push(':root {');
        for (var k in dv) lines.push('  --c-' + k + ': ' + dv[k] + ';');
        lines.push('}');
        lines.push(':root.light-theme,');
        lines.push('html[data-theme="light"] {');
        for (var k2 in lv) lines.push('  --c-' + k2 + ': ' + lv[k2] + ';');
        lines.push('}');
        return lines.join('\n');
    }

    /* 生成硬编码颜色覆盖（暗色 + 亮色双模） */
    function buildHardcoded(p) {
        var d = p.dark, l = p.light;
        var L = [];

        /* 同时生成暗色 / 亮色两套规则（自动给逗号分隔的每个选择器加前缀） */
        function dual(sel, darkProps, lightProps) {
            var sels = sel.split(',').map(function (s) { return s.trim(); });
            var dSels = sels.map(function (s) { return ':root:not(.light-theme) ' + s; }).join(',\n');
            var lSels = sels.map(function (s) {
                return ':root.light-theme ' + s + ', html[data-theme="light"] ' + s;
            }).join(',\n');
            L.push(dSels + ' {');
            darkProps.forEach(function (x) { L.push('  ' + x); });
            L.push('}');
            L.push(lSels + ' {');
            lightProps.forEach(function (x) { L.push('  ' + x); });
            L.push('}');
        }

        /* --- 页面 / 聊天背景 --- */
        dual('.page, .chat-overlay', [
            'background: radial-gradient(ellipse at 50% 0%, ' + d.v['bg-app'] + ', ' + d.v['bg-page'] + ') !important;'
        ], [
            'background: radial-gradient(ellipse at 50% 0%, ' + l.v['bg-app'] + ', ' + l.v['bg-page'] + ') !important;'
        ]);

        /* --- 头部渐变 --- */
        dual('#pageSessions .header, #pageRequests .header, .chat-overlay .chat-header', [
            'background: linear-gradient(180deg, ' + d.v['bg-panel'] + ' 0%, ' + d.v['bg-app'] + ' 100%) !important;',
            'border-bottom-color: var(--c-border) !important;'
        ], [
            'background: linear-gradient(180deg, ' + l.v['bg-panel'] + ' 0%, ' + l.v['bg-app'] + ' 100%) !important;',
            'border-bottom-color: var(--c-border) !important;'
        ]);

        /* --- 底部导航栏 --- */
        dual('.bottom-nav', [
            'background: linear-gradient(0deg, ' + d.v['bg-panel'] + ' 0%, ' + d.v['bg-app'] + ' 100%) !important;',
            'border-top-color: var(--c-border) !important;'
        ], [
            'background: linear-gradient(0deg, ' + l.v['bg-panel'] + ' 0%, ' + l.v['bg-app'] + ' 100%) !important;',
            'border-top-color: var(--c-border) !important;'
        ]);

        /* --- 自己的消息气泡 --- */
        dual('.chat-bubble.self', [
            'background: linear-gradient(135deg, ' + d.s1 + ' 0%, ' + d.s2 + ' 100%) !important;',
            'color: #fff !important;',
            'box-shadow: 0 4px 16px rgba(' + d.rgb + ',0.35) !important;'
        ], [
            'background: linear-gradient(135deg, ' + l.s1 + ' 0%, ' + l.s2 + ' 100%) !important;',
            'color: #fff !important;',
            'box-shadow: 0 4px 16px rgba(' + l.rgb + ',0.35) !important;'
        ]);

        /* --- 对方消息气泡 --- */
        dual('.chat-bubble.other', [
            'background: ' + d.v['bg-card'] + ' !important;',
            'border: 1px solid var(--c-border) !important;',
            'color: var(--c-text) !important;',
            'box-shadow: 0 2px 8px rgba(' + d.rgb + ',0.08) !important;'
        ], [
            'background: #ffffff !important;',
            'border: 1px solid var(--c-border) !important;',
            'color: var(--c-text) !important;',
            'box-shadow: 0 2px 8px rgba(' + l.rgb + ',0.08) !important;'
        ]);

        /* --- 滚动条 --- */
        dual('.scrollbar::-webkit-scrollbar-thumb', [
            'background: ' + d.sb + ' !important;'
        ], [
            'background: ' + l.sb + ' !important;'
        ]);
        dual('.scrollbar::-webkit-scrollbar-thumb:hover', [
            'background: ' + d.sbh + ' !important;'
        ], [
            'background: ' + l.sbh + ' !important;'
        ]);

        /* --- Toast 阴影 --- */
        dual('.toast', [
            'background: ' + d.v['bg-card'] + ' !important;',
            'color: var(--c-text) !important;',
            'box-shadow: 0 8px 30px rgba(' + d.rgb + ',0.25) !important;'
        ], [
            'background: ' + l.v['bg-card'] + ' !important;',
            'color: var(--c-text) !important;',
            'box-shadow: 0 8px 30px rgba(' + l.rgb + ',0.25) !important;'
        ]);

        /* --- 右键菜单 --- */
        dual('.context-menu', [
            'background: ' + d.v['bg-menu'] + ' !important;',
            'border-color: var(--c-border) !important;',
            'box-shadow: 0 8px 32px rgba(' + d.rgb + ',0.18) !important;'
        ], [
            'background: #ffffff !important;',
            'border-color: var(--c-border) !important;',
            'box-shadow: 0 8px 32px rgba(' + l.rgb + ',0.18) !important;'
        ]);

        /* --- 存储 FAB 阴影 --- */
        dual('.storage-fab', [
            'box-shadow: 0 4px 16px rgba(' + d.rgb + ',0.4) !important;'
        ], [
            'box-shadow: 0 4px 16px rgba(' + l.rgb + ',0.4) !important;'
        ]);

        /* === 以下用 var() 引用，两种模式自动适配，无需 dual === */
        var auto = [
            '.msg.self { background: var(--c-accent-soft-bg) !important; border-color: var(--c-accent-soft-border) !important; }',
            '.msg.self:hover { background: var(--c-accent-soft-bg) !important; filter: brightness(1.15); }',
            '.session-item.pinned { background: var(--c-accent-soft-bg) !important; }',
            '.search-bar input:focus, .input-row .wrap:focus-within, input:focus, textarea:focus { border-color: var(--c-accent) !important; box-shadow: 0 0 0 3px var(--c-accent-soft-bg) !important; }',
            '.cropper-view-box { outline-color: var(--c-accent) !important; outline: 2px solid var(--c-accent) !important; }'
        ];
        auto.forEach(function (r) { L.push(r); });

        return L.join('\n');
    }

    /* 组合完整 CSS */
    function buildCSS(paletteId) {
        var p = PALETTES[paletteId];
        if (!p) return '';
        return '/* ' + p.label + ' 主题 */\n' + buildVars(p) + '\n\n' + buildHardcoded(p);
    }

    /* ========================================================
     *  主题应用 / 移除
     * ====================================================== */
    var _styleEl = null;

    function applyTheme(paletteId) {
        removeTheme();
        if (!paletteId || !PALETTES[paletteId]) return;
        _styleEl = document.createElement('style');
        _styleEl.id = STYLE_ID;
        _styleEl.setAttribute('data-plugin-color-theme', paletteId);
        _styleEl.textContent = buildCSS(paletteId);
        document.head.appendChild(_styleEl);
    }

    function removeTheme() {
        if (_styleEl) { _styleEl.remove(); _styleEl = null; }
        var ex = document.getElementById(STYLE_ID);
        if (ex) ex.remove();
    }

    /* ========================================================
     *  持久化
     * ====================================================== */
    function getCurrent() {
        try { return SuChatPlugin.storage.get(STORAGE_KEY) || ''; } catch (e) { return ''; }
    }
    function setCurrent(id) {
        try { SuChatPlugin.storage.set(STORAGE_KEY, id); } catch (e) {}
    }

    /* ========================================================
     *  色彩选择器 UI
     * ====================================================== */
    var PICKER_CSS = [
        '#' + PICKER_ID + ' { margin-top: 10px; }',
        '#' + PICKER_ID + ' .cp-title { text-align: center; color: var(--c-text-3); font-size: 13px; margin-bottom: 10px; }',
        '#' + PICKER_ID + ' .cp-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }',
        '#' + PICKER_ID + ' .cp-dot {',
        '  width: 38px; height: 38px; border-radius: 50%;',
        '  border: 2px solid rgba(128,128,128,0.25);',
        '  cursor: pointer; position: relative;',
        '  transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;',
        '  flex-shrink: 0; padding: 0; outline: none;',
        '}',
        '#' + PICKER_ID + ' .cp-dot:hover { transform: scale(1.12); }',
        '#' + PICKER_ID + ' .cp-dot.active {',
        '  border-color: transparent;',
        '  box-shadow: 0 0 0 2px var(--c-bg-card), 0 0 0 4px currentColor;',
        '  transform: scale(1.08);',
        '}',
        '#' + PICKER_ID + ' .cp-dot.cp-default {',
        '  background: linear-gradient(135deg, var(--c-bg-panel), var(--c-bg-hover)) !important;',
        '  color: var(--c-text-3) !important;',
        '  display: flex; align-items: center; justify-content: center;',
        '  font-size: 9px; line-height: 1;',
        '}',
        '#' + PICKER_ID + ' .cp-label {',
        '  text-align: center; margin-top: 8px;',
        '  font-size: 12px; color: var(--c-text-muted);',
        '  min-height: 16px;',
        '}'
    ].join('\n');

    var _pickerEl = null;
    var _profileObserver = null;

    function buildPickerHTML() {
        var dots = '<button type="button" class="cp-dot cp-default" data-color="" title="默认配色">默认</button>';
        for (var id in PALETTES) {
            var p = PALETTES[id];
            dots += '<button type="button" class="cp-dot" data-color="' + id + '"' +
                ' style="background:' + p.dotGrad + ';color:' + p.dark.v['accent'] + ';"' +
                ' title="' + p.label + '"></button>';
        }
        return '<div class="cp-title">—— 色彩 ——</div>' +
            '<div class="cp-row">' + dots + '</div>' +
            '<div class="cp-label"></div>';
    }

    function syncPickerState() {
        if (!_pickerEl) return;
        var current = getCurrent();
        var dots = _pickerEl.querySelectorAll('.cp-dot');
        var labelEl = _pickerEl.querySelector('.cp-label');
        for (var i = 0; i < dots.length; i++) {
            var d = dots[i];
            if (d.getAttribute('data-color') === current) {
                d.classList.add('active');
            } else {
                d.classList.remove('active');
            }
        }
        if (labelEl) {
            labelEl.textContent = current ? (PALETTES[current].icon + ' ' + PALETTES[current].label) : '默认配色';
        }
    }

    function injectPicker() {
        var sw = document.getElementById('themeSwitch');
        if (!sw) return false;
        if (document.getElementById(PICKER_ID)) {
            _pickerEl = document.getElementById(PICKER_ID);
            syncPickerState();
            return true;
        }
        var div = document.createElement('div');
        div.id = PICKER_ID;
        div.innerHTML = buildPickerHTML();
        sw.parentNode.insertBefore(div, sw.nextSibling);
        _pickerEl = div;

        div.addEventListener('click', function (e) {
            var btn = e.target.closest('.cp-dot');
            if (!btn) return;
            var colorId = btn.getAttribute('data-color');
            setCurrent(colorId);
            if (colorId && PALETTES[colorId]) {
                applyTheme(colorId);
                showToast(PALETTES[colorId].icon + ' ' + PALETTES[colorId].label + ' 主题已应用');
            } else {
                removeTheme();
                showToast('🎨 已恢复默认配色');
            }
            syncPickerState();
        });
        syncPickerState();
        return true;
    }

    /* ========================================================
     *  初始化 & 生命周期
     * ====================================================== */
    try {
        /* 注入选择器样式（始终存在） */
        var pstyle = document.createElement('style');
        pstyle.id = PICKER_STYLE_ID;
        pstyle.textContent = PICKER_CSS;
        document.head.appendChild(pstyle);

        /* 注入色彩选择器到个人主页 */
        injectPicker();

        /* DOM 变化监听：宿主可能重新渲染个人主页导致选择器丢失 */
        _profileObserver = new MutationObserver(function () {
            if (!document.getElementById(PICKER_ID)) {
                injectPicker();
            }
        });
        _profileObserver.observe(document.body, { childList: true, subtree: true });

        /* 首次加载：读取偏好并应用 */
        var saved = getCurrent();
        if (saved && PALETTES[saved]) {
            applyTheme(saved);
        }

        /* 卸载清理 */
        SuChatPlugin.onUnload(function () {
            removeTheme();
            if (_pickerEl) { _pickerEl.remove(); _pickerEl = null; }
            var ps = document.getElementById(PICKER_STYLE_ID);
            if (ps) ps.remove();
            if (_profileObserver) { try { _profileObserver.disconnect(); } catch (_) {} }
        });

    } catch (e) {
        console.error('[suchat-plugin-color-themes] init failed:', e);
        throw e;
    }
})(
    (typeof SuChatPlugin !== 'undefined' && SuChatPlugin) ||
    (typeof window !== 'undefined' && typeof window.SuChatPlugin !== 'undefined' && window.SuChatPlugin) ||
    (function () { throw new Error('[suchat-plugin-color-themes] 未找到 SuChatPlugin 宿主 API。'); })()
);

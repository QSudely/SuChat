/**
 * SuChat 插件：消息翻译
 *
 * @id          suchat-translator
 * @name        消息翻译
 * @version     1.1.0
 * @author      SuChat Team
 * @desc        在聊天消息右键菜单中添加翻译选项，点击后弹窗显示翻译结果，支持多语言互译（MyMemory 接口，国内可直连）
 *
 * @permissions ui_msg_menu, http
 */
(function (SuChatPlugin) {
    'use strict';

    // ===== 语言列表 =====
    // mm = MyMemory 接口使用的语言代码
    var LANGS = [
        { code: 'auto', name: '自动检测', mm: null },
        { code: 'zh',   name: '中文',     mm: 'zh-CN' },
        { code: 'en',   name: '英语',     mm: 'en' },
        { code: 'ja',   name: '日语',     mm: 'ja' },
        { code: 'ko',   name: '韩语',     mm: 'ko' },
        { code: 'fr',   name: '法语',     mm: 'fr' },
        { code: 'de',   name: '德语',     mm: 'de' },
        { code: 'es',   name: '西班牙语', mm: 'es' },
        { code: 'ru',   name: '俄语',     mm: 'ru' },
        { code: 'ar',   name: '阿拉伯语', mm: 'ar' },
        { code: 'it',   name: '意大利语', mm: 'it' },
        { code: 'pt',   name: '葡萄牙语', mm: 'pt' },
        { code: 'th',   name: '泰语',     mm: 'th' },
        { code: 'vi',   name: '越南语',   mm: 'vi' }
    ];

    var LANG_MAP = {};
    LANGS.forEach(function (l) { LANG_MAP[l.code] = l.name; });

    function mmCode(code) {
        var l = LANG_MAP[code] ? LANGS.filter(function (x) { return x.code === code; })[0] : null;
        return l ? l.mm : code;
    }

    // ===== 简单语言自动检测（基于 Unicode 区段） =====
    function detectLang(text) {
        if (!text) return 'en';
        var has = function (re) { return re.test(text); };
        if (has(/[\uAC00-\uD7AF\u1100-\u11FF]/)) return 'ko';       // 谚文
        if (has(/[\u3040-\u309F\u30A0-\u30FF]/)) return 'ja';       // 假名
        if (has(/[\u4E00-\u9FFF\u3400-\u4DBF]/)) return 'zh';       // 汉字
        if (has(/[\u0400-\u04FF]/)) return 'ru';                    // 西里尔
        if (has(/[\u0600-\u06FF]/)) return 'ar';                    // 阿拉伯
        if (has(/[\u0E00-\u0E7F]/)) return 'th';                    // 泰文
        return 'en';                                                // 拉丁字母默认英语
    }

    // ===== DOM 元素 =====
    var _overlay = null;
    var _sourceLang = 'auto';
    var _targetLang = 'zh';
    var _lastText = '';

    // ===== 创建翻译弹窗 =====
    function createModal() {
        if (_overlay) return _overlay;

        _overlay = document.createElement('div');
        _overlay.id = 'translator-modal-overlay';
        _overlay.style.cssText = [
            'position:fixed',
            'top:0', 'left:0', 'right:0', 'bottom:0',
            'background:rgba(0,0,0,0.5)',
            'z-index:99999',
            'display:none',
            'align-items:center',
            'justify-content:center',
            'backdrop-filter:blur(4px)',
            '-webkit-backdrop-filter:blur(4px)',
            'animation:trFadeIn 0.2s ease'
        ].join(';');

        var modal = document.createElement('div');
        modal.id = 'translator-modal';
        modal.style.cssText = [
            'background:var(--c-bg-app,#fff)',
            'border-radius:16px',
            'width:min(440px,92vw)',
            'max-height:80vh',
            'overflow:hidden',
            'display:flex',
            'flex-direction:column',
            'box-shadow:0 8px 32px rgba(0,0,0,0.3)',
            'animation:trSlideUp 0.25s ease'
        ].join(';');

        // 头部：语言选择
        var header = document.createElement('div');
        header.style.cssText = [
            'padding:16px 20px',
            'border-bottom:1px solid var(--c-border,rgba(0,0,0,0.08))',
            'display:flex',
            'align-items:center',
            'gap:8px',
            'flex-wrap:wrap'
        ].join(';');

        function makeSelect(value, onchange) {
            var sel = document.createElement('select');
            sel.style.cssText = [
                'padding:6px 10px',
                'border-radius:8px',
                'border:1px solid var(--c-border,rgba(0,0,0,0.12))',
                'background:var(--c-bg-page,#f5f7fa)',
                'color:var(--c-text,#333)',
                'font-size:13px',
                'cursor:pointer',
                'outline:none',
                'flex:1',
                'min-width:90px'
            ].join(';');
            LANGS.forEach(function (l) {
                var opt = document.createElement('option');
                opt.value = l.code;
                opt.textContent = l.name;
                if (l.code === value) opt.selected = true;
                sel.appendChild(opt);
            });
            sel.addEventListener('change', function () { onchange(sel.value); });
            return sel;
        }

        var srcLabel = document.createElement('span');
        srcLabel.textContent = '🌐';
        srcLabel.style.fontSize = '16px';

        var srcSelect = makeSelect(_sourceLang, function (v) {
            _sourceLang = v;
            if (_lastText) doTranslate(_lastText);
        });

        var arrow = document.createElement('span');
        arrow.textContent = '→';
        arrow.style.cssText = 'color:var(--c-text-2,#999);font-size:14px;flex-shrink:0';

        var tgtSelect = makeSelect(_targetLang, function (v) {
            _targetLang = v;
            if (_lastText) doTranslate(_lastText);
        });

        // 交换按钮
        var swapBtn = document.createElement('button');
        swapBtn.textContent = '⇄';
        swapBtn.title = '交换语言';
        swapBtn.style.cssText = [
            'width:32px', 'height:32px',
            'border-radius:50%',
            'border:1px solid var(--c-border,rgba(0,0,0,0.12))',
            'background:var(--c-bg-page,#f5f7fa)',
            'color:var(--c-text,#333)',
            'cursor:pointer',
            'font-size:14px',
            'flex-shrink:0',
            'display:flex', 'align-items:center', 'justify-content:center',
            'transition:all 0.2s'
        ].join(';');
        swapBtn.addEventListener('mouseenter', function () {
            swapBtn.style.transform = 'rotate(180deg)';
        });
        swapBtn.addEventListener('mouseleave', function () {
            swapBtn.style.transform = '';
        });
        swapBtn.addEventListener('click', function () {
            if (_sourceLang === 'auto') return; // auto 不能交换
            var tmp = _sourceLang;
            _sourceLang = _targetLang;
            _targetLang = tmp;
            srcSelect.value = _sourceLang;
            tgtSelect.value = _targetLang;
            if (_lastText) doTranslate(_lastText);
        });

        header.appendChild(srcLabel);
        header.appendChild(srcSelect);
        header.appendChild(arrow);
        header.appendChild(tgtSelect);
        header.appendChild(swapBtn);

        // 原文区域
        var srcArea = document.createElement('div');
        srcArea.style.cssText = [
            'padding:16px 20px 8px',
            'border-bottom:1px solid var(--c-border,rgba(0,0,0,0.06))'
        ].join(';');

        var srcTitle = document.createElement('div');
        srcTitle.style.cssText = 'font-size:11px;color:var(--c-text-2,#999);margin-bottom:6px';
        srcTitle.textContent = '原文';

        var srcText = document.createElement('div');
        srcText.id = 'tr-src-text';
        srcText.style.cssText = [
            'font-size:14px',
            'color:var(--c-text,#333)',
            'line-height:1.6',
            'word-break:break-word',
            'white-space:pre-wrap',
            'max-height:120px',
            'overflow-y:auto'
        ].join(';');

        srcArea.appendChild(srcTitle);
        srcArea.appendChild(srcText);

        // 译文区域
        var tgtArea = document.createElement('div');
        tgtArea.style.cssText = 'padding:16px 20px 8px;flex:1;overflow-y:auto';

        var tgtTitle = document.createElement('div');
        tgtTitle.style.cssText = 'font-size:11px;color:var(--c-text-2,#999);margin-bottom:6px';
        tgtTitle.textContent = '译文';

        var tgtText = document.createElement('div');
        tgtText.id = 'tr-tgt-text';
        tgtText.style.cssText = [
            'font-size:15px',
            'color:var(--c-text,#333)',
            'line-height:1.7',
            'word-break:break-word',
            'white-space:pre-wrap',
            'min-height:48px'
        ].join(';');

        tgtArea.appendChild(tgtTitle);
        tgtArea.appendChild(tgtText);

        // 底部按钮
        var footer = document.createElement('div');
        footer.style.cssText = [
            'padding:12px 20px',
            'border-top:1px solid var(--c-border,rgba(0,0,0,0.06))',
            'display:flex',
            'gap:10px',
            'justify-content:flex-end'
        ].join(';');

        var copyBtn = document.createElement('button');
        copyBtn.textContent = '📋 复制译文';
        copyBtn.style.cssText = btnStyle(false);

        var closeBtn = document.createElement('button');
        closeBtn.textContent = '关闭';
        closeBtn.style.cssText = btnStyle(true);

        copyBtn.addEventListener('click', function () {
            var text = tgtText.textContent;
            if (text) {
                navigator.clipboard.writeText(text).then(function () {
                    SuChatPlugin.toast('已复制译文');
                }).catch(function () {
                    // fallback
                    var ta = document.createElement('textarea');
                    ta.value = text;
                    document.body.appendChild(ta);
                    ta.select();
                    try { document.execCommand('copy'); SuChatPlugin.toast('已复制译文'); }
                    catch (e) { SuChatPlugin.toast('复制失败'); }
                    document.body.removeChild(ta);
                });
            }
        });

        closeBtn.addEventListener('click', hideModal);

        footer.appendChild(copyBtn);
        footer.appendChild(closeBtn);

        modal.appendChild(header);
        modal.appendChild(srcArea);
        modal.appendChild(tgtArea);
        modal.appendChild(footer);
        _overlay.appendChild(modal);
        document.body.appendChild(_overlay);

        // 点击遮罩关闭
        _overlay.addEventListener('click', function (e) {
            if (e.target === _overlay) hideModal();
        });

        // ESC 关闭
        _overlay._escHandler = function (e) {
            if (e.key === 'Escape' && _overlay.style.display === 'flex') hideModal();
        };
        document.addEventListener('keydown', _overlay._escHandler);

        return _overlay;
    }

    function btnStyle(primary) {
        var base = [
            'padding:8px 18px',
            'border-radius:10px',
            'font-size:13px',
            'cursor:pointer',
            'border:none',
            'transition:all 0.2s',
            'outline:none'
        ].join(';');
        if (primary) {
            return base + ';background:var(--c-accent,#5a6fff);color:#fff';
        }
        return base + ';background:var(--c-bg-page,#f5f7fa);color:var(--c-text,#333);border:1px solid var(--c-border,rgba(0,0,0,0.12))';
    }

    function showModal(srcText) {
        var ov = createModal();
        _lastText = srcText;
        ov.querySelector('#tr-src-text').textContent = srcText;
        ov.querySelector('#tr-tgt-text').textContent = '翻译中…';
        ov.style.display = 'flex';
        doTranslate(srcText);
    }

    function hideModal() {
        if (_overlay) _overlay.style.display = 'none';
    }

    // ===== 调用翻译 API =====
    // 使用 MyMemory 翻译 API（免费、无需 key、支持 CORS、国内可直连）
    // 注：Google 翻译接口在国内网络无法访问，故弃用
    var REQUEST_TIMEOUT = 20000; // 单次请求超时（毫秒）

    // MyMemory 单次请求上限约 500 字节，长文本需分段
    function splitChunks(text) {
        var MAX_BYTES = 480;
        var chunks = [];
        var enc = new TextEncoder();
        var start = 0;
        while (start < text.length) {
            var len = 0;
            var end = start;
            // 尽量多吃字符，但不超过字节上限；优先在标点/空格处断开
            var softBreak = -1;
            while (end < text.length) {
                var ch = enc.encode(text[end]).length;
                if (len + ch > MAX_BYTES) break;
                len += ch;
                if (/[，。！？；、,.!?;:\s\n]/.test(text[end])) softBreak = end + 1;
                end++;
            }
            if (end === start) { end = start + 1; } // 单字符超长兜底
            if (softBreak > start && softBreak < end && end < text.length) {
                chunks.push(text.slice(start, softBreak));
                start = softBreak;
            } else {
                chunks.push(text.slice(start, end));
                start = end;
            }
        }
        return chunks;
    }

    // 带超时的 fetch（宿主 http.fetch 透传 signal；Promise.race 双保险）
    function fetchWithTimeout(url) {
        var aborter = typeof AbortController !== 'undefined' ? new AbortController() : null;
        var timer = setTimeout(function () {
            if (aborter) aborter.abort();
        }, REQUEST_TIMEOUT);
        var timedOut = false;
        var timeoutGuard = new Promise(function (resolve, reject) {
            setTimeout(function () {
                timedOut = true;
                reject(new Error('请求超时'));
            }, REQUEST_TIMEOUT + 500);
        });
        return SuChatPlugin.http.fetch(url, aborter ? { method: 'GET', signal: aborter.signal } : { method: 'GET' })
            .then(function (res) {
                clearTimeout(timer);
                return Promise.race([res.json(), timeoutGuard]);
            })
            .catch(function (err) {
                clearTimeout(timer);
                if (timedOut) throw new Error('请求超时');
                throw err;
            });
    }

    function doTranslate(text) {
        if (!text) return;
        var tgtEl = _overlay.querySelector('#tr-tgt-text');

        // 确定源语言：auto 则自动检测
        var sl = _sourceLang === 'auto' ? detectLang(text) : _sourceLang;
        var slMM = mmCode(sl);
        var tlMM = mmCode(_targetLang);

        // 源语言与目标语言相同（如中文消息、目标中文）：无需翻译
        if (slMM === tlMM) {
            tgtEl.textContent = '（原文已是目标语言）\n' + text;
            updateDetectInfo(LANG_MAP[sl] || sl);
            return;
        }

        var chunks = splitChunks(text);
        var translated = '';
        var failed = false;

        // 弹窗已显示"翻译中…"；首次请求会弹宿主网络权限确认框，给个提示
        SuChatPlugin.toast('🌐 正在翻译…（首次使用请在弹窗中点击「允许」）');

        // 串行请求各分段，保证译文顺序
        var chain = Promise.resolve();
        chunks.forEach(function (chunk) {
            chain = chain.then(function () {
                if (failed) return;
                var url = 'https://api.mymemory.translated.net/get'
                    + '?q=' + encodeURIComponent(chunk)
                    + '&langpair=' + encodeURIComponent(slMM + '|' + tlMM)
                    + '&mt=1';
                return fetchWithTimeout(url).then(function (data) {
                    if (data && data.responseData && typeof data.responseData.translatedText === 'string') {
                        if (data.responseStatus && data.responseStatus !== 200) {
                            throw new Error(data.responseDetails || '接口返回错误');
                        }
                        translated += data.responseData.translatedText;
                    } else {
                        throw new Error('返回数据格式异常');
                    }
                });
            });
        });

        chain.then(function () {
            tgtEl.textContent = translated || '（无翻译结果）';
            updateDetectInfo(LANG_MAP[sl] || sl);
        }).catch(function (err) {
            var msg = err && err.message ? err.message : '网络错误';
            if (msg.indexOf('超时') >= 0) {
                tgtEl.textContent = '⚠️ 翻译失败：请求超时。首次使用需在弹窗中点击「允许」授权网络权限，请重试。';
            } else if (/Failed to fetch|NetworkError|network/i.test(msg)) {
                tgtEl.textContent = '⚠️ 翻译失败：网络错误。请检查网络连接后重试。';
            } else {
                tgtEl.textContent = '⚠️ 翻译失败：' + msg;
            }
            if (translated) tgtEl.textContent += '\n（已获取部分译文）\n' + translated;
        });
    }

    function updateDetectInfo(langName) {
        var srcTitle = _overlay.querySelector('#tr-src-text').previousElementSibling;
        if (srcTitle) {
            srcTitle.textContent = '原文' + (langName ? '（' + langName + '）' : '');
        }
    }

    // ===== 注入动画 CSS =====
    function injectStyles() {
        var style = document.createElement('style');
        style.id = 'suchat-translator-styles';
        style.textContent = [
            '@keyframes trFadeIn { from { opacity:0 } to { opacity:1 } }',
            '@keyframes trSlideUp { from { opacity:0; transform:translateY(20px) scale(0.96) } to { opacity:1; transform:translateY(0) scale(1) } }',
            '#translator-modal-overlay select option { color:#333; background:#fff; }',
            'html[data-theme="dark"] #translator-modal-overlay select option { color:#333; background:#fff; }'
        ].join('\n');
        document.head.appendChild(style);
        return style;
    }

    var _styleEl = injectStyles();

    // ===== 注册消息右键菜单项 =====
    SuChatPlugin.ui.registerMessageMenuItem({
        id: 'translate',
        icon: '🌐',
        label: '翻译',
        visible: function (msg) {
            // 仅文本消息可翻译
            if (!msg) return false;
            if (msg.raw && msg.raw.type && msg.raw.type !== 'text') return false;
            return !!msg.text;
        },
        onClick: function (msg, sessionId, api) {
            var text = msg.text || (msg.raw && msg.raw.text) || '';
            if (!text) {
                api.toast('无法翻译：消息内容为空');
                return;
            }
            showModal(text);
        }
    });

    // ===== 卸载清理 =====
    SuChatPlugin.onUnload(function () {
        hideModal();
        if (_overlay) {
            if (_overlay._escHandler) {
                document.removeEventListener('keydown', _overlay._escHandler);
            }
            _overlay.remove();
            _overlay = null;
        }
        if (_styleEl) { _styleEl.remove(); _styleEl = null; }
    });

})(typeof SuChatPlugin !== 'undefined' && SuChatPlugin);
